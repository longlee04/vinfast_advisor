# Test-only PostgreSQL maintenance connection.
#
# The integration fixtures use this URL only to create disposable databases
# named p150_<module>_test_<uuid>. Never put a dev, staging, or production
# credential here. Copy this file to a private local environment file or set the
# variables in the current shell; do not commit real credentials.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://p150_test_admin:p150_test_only_password@localhost:55432/postgres

# Test-only MinIO service. Document and Image fixtures create a random bucket
# per pytest session and remove only that fixture-owned bucket.
DOCUMENT_MINIO_ENDPOINT=http://localhost:19000
DOCUMENT_ACCESS_KEY=p150_test_minio
DOCUMENT_SECRET_KEY=p150_test_minio_password
