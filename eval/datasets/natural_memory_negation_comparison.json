            "vehicle_type": "CAR",
            "passenger_count": 5,
            "budget_max_vnd": "800 triệu",
            "intents": [
              "ADVISORY"
            ]
          },
          "expected_slots": {
            "vehicle_type": "CAR",
            "passenger_count": 5,
            "budget_max_vnd": 800000000
