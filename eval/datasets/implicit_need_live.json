{
  "version": 1,
  "scenarios": [
    {
      "id": "SC101",
      "description": "Thông số ô tô, ngân sách và số chỗ không có động từ nhu cầu",
      "groups": ["implicit_need", "no_need_verb", "car"],
      "expects_completion": true,
      "turns": [
        {
          "user_message": "Ô tô, 500 triệu, 5 chỗ.",
          "expected_slots": {
            "vehicle_type": "CAR",
            "budget_max_vnd": 500000000,
            "passenger_count": 5
          },
          "provided_slots": ["vehicle_type", "budget_max_vnd", "passenger_count"],
          "expected_intents": ["ADVISORY"],
          "expected_decision": "RETRIEVE",
          "expected_next_slot": null
        }
      ]
    },
