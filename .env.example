# ============================================
# AI20K Project — Environment Variables
# ============================================

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
FALLBACK_MODEL_NAME=gpt-4o
MODERATION_MODEL_NAME=omni-moderation-latest

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
POSTGRES_USER=p150_auth
POSTGRES_PASSWORD=p150_local_dev
POSTGRES_DB=p150_auth
POSTGRES_PORT=5432

# ---- pgAdmin (local development) ----
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@p150-local.com
PGADMIN_DEFAULT_PASSWORD=change-me-locally
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store / RAG ----
# Vector store là extension `pgvector` ngay trong PostgreSQL ở trên,
# không dùng vector DB riêng (Chroma/Pinecone/Qdrant) -> không có URL riêng.
# Endpoint model BGE-M3 (embedding) và BGE-reranker-v2-m3 (rerank).
# Để trống nếu chưa dựng model serving; không commit giá trị thật.
EMBEDDING_PROVIDER_URL=
RERANKER_PROVIDER_URL=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ============================================
# Auth module (src/auth)
# ============================================
AUTH_ENABLED=true

AUTH_DATABASE_URL=postgresql+asyncpg://p150_auth:p150_local_dev@localhost:5432/p150_auth

# Generate each one separately, they must not be equal:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SIGNING_KEY=change-me-generate-a-fresh-key
AUTH_CSRF_SECRET=change-me-generate-a-different-key

AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=p150-auth
AUTH_JWT_AUDIENCE=p150-app

AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_FRONTEND_ORIGIN=http://localhost:3000

AUTH_COOKIE_SECURE=true

AUTH_SENDGRID_API_KEY=
AUTH_SENDGRID_FROM_EMAIL=noreply@localhost
# false = khach dang ky xong dung duoc ngay, khong can bam link trong thu.
# Chi tat khi duong gui thu chua chay duoc; bat lai ngay khi no thong, vi tat
# nghia la nguoi ta dang ky duoc bang dia chi thu cua nguoi khac.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Domain thu khach duoc dang ky, ngan cach bang dau phay. Bo trong = dung mac
# dinh trong code (gmail, outlook, hotmail, yahoo, icloud). Danh sach nay dung
# cho CA dang ky va dang nhap, nen chi noi them, dung cat bot: cat mot domain
# la khoa dang nhap cua khach cu dang dung domain do.
AUTH_CUSTOMER_EMAIL_DOMAINS=

AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RECOVERY_RATE_LIMIT_ATTEMPTS=3
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600

# ---- Dang nhap Google (OAuth 2.0 Authorization Code) ----
# Ten bien KHONG mang tien to AUTH_ vi do Google Cloud Console cap va da nam
# san trong .env trien khai. Bo trong bat ky bien nao -> tinh nang tat,
# GET /api/v1/auth/google/start tra 404.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://evadvisor150.id.vn/api/v1/auth/google/callback

# ============================================
# Document module (src/document)
# ============================================
DOCUMENT_ENABLED=true

DOCUMENT_DATABASE_URL=postgresql+asyncpg://p150_auth:p150_local_dev@localhost:5432/p150_auth

DOCUMENT_MINIO_ENDPOINT=http://localhost:9000
DOCUMENT_BUCKET_NAME=documents
DOCUMENT_ACCESS_KEY=p150_minio
DOCUMENT_SECRET_KEY=p150_minio_test_secret
DOCUMENT_BUCKET_PRIVATE=true

# Uploads are limited to 25 MiB. The MIME allow-list is fixed in code and
# presigned downloads always expire after 60 seconds.

# Cho luu anh so sanh da render. De trong = data/comparison_images (mac dinh).
# `data/` do container tao nen thuoc root; tro sang thu muc user ghi duoc.
COMPARISON_IMAGE_DIR=./data-p150/comparison_images

# ============================================
# Product module (src/product) — catalog phương tiện
# ============================================
# Shares the physical database with auth/document; isolated via its own
# product_alembic_version table (mục 5 docs/vinfast-agent-mvp.md).
PRODUCT_DATABASE_URL=

# ============================================
# Agent module (src/agents) — hội thoại, tư vấn, HITL
# ============================================
# Shares the physical database with auth/document/product; isolated via its
# own agent_alembic_version table (mục 5 docs/vinfast-agent-mvp.md).
# Run `uv run alembic -c alembic-agent.ini upgrade head` before enabling.
AGENT_DATABASE_URL=

# Enable only after reviewed policy scopes/chunks have been published.
POLICY_RAG_ENABLED=false

# ============================================
# Locations module (src/locations) — trạm sạc, showroom, xưởng dịch vụ
# ============================================
# Shares the physical database with auth/product; isolated via its own
# locations_alembic_version table.
LOCATIONS_ENABLED=true
LOCATIONS_DATABASE_URL=postgresql+asyncpg://p150_auth:p150_local_dev@localhost:5432/p150_auth


# ============================================
# Quote risk gate (src/agents/services/quote_gate) — cổng rủi ro báo giá
# ============================================
# Bảng ưu đãi ĐÃ DUYỆT, tên chương trình ngăn bằng dấu phẩy. CHỦ SỞ HỮU: phòng
# kinh doanh. Để trống nghĩa là mọi lời nhắc khuyến mãi đều bị coi là ngoài
# chính sách chuẩn và phải qua tư vấn viên — chiều an toàn, và là mặc định.
# Khớp theo chuỗi con, không phân biệt hoa thường.
QUOTE_STANDARD_PROMOTIONS=
